# Default mode keeps AI, leads, and pages local in the browser.
VITE_INLET_AI_MODE=client
VITE_INLET_LEAD_MODE=local
# Client-side AI keys are session-only by default. Enable only for trusted local testing.
# VITE_INLET_ALLOW_CLIENT_AI_KEY_STORAGE=1

# Server-backed admin/editor mode.
# VITE_INLET_AI_MODE=server
# VITE_INLET_LEAD_MODE=server
# VITE_INLET_PAGE_MODE=server
# Internal-only builder/admin mode. Use server sessions before exposing this outside a trusted operator environment.
# VITE_INLET_ENABLE_OWNER_ADMIN_MODE=1
# VITE_INLET_API_BASE=http://localhost:8787
# VITE_INLET_PUBLIC_BASE_URL=https://pagero.kr
# VITE_INLET_API_TOKEN=change-me
# VITE_INLET_MAP_EMBED_BASE=https://map.inlet.page/embed
# VITE_GOOGLE_MAPS_EMBED_KEY=your-google-maps-embed-key
# VITE_INLET_INTEGRATION_TIMEOUT_MS=10000

# Custom code blocks render HTML/CSS by default. JS execution is disabled unless explicitly enabled.
# VITE_INLET_ENABLE_CUSTOM_CODE_JS=1

# API server.
# INLET_API_PORT=8787
# INLET_API_TOKEN=change-me
# INLET_DATA_DIR=server/data
# Comma-separated production frontend origins. Leave blank only for local/dev wildcard CORS.
# INLET_ALLOWED_ORIGINS=https://pagero.kr,https://www.pagero.kr,https://inlet-8mr.pages.dev
# INLET_INTEGRATION_TIMEOUT_MS=10000
# Hosted API launch QA. Use the deployed API base URL, not the static Pages URL.
# INLET_PUBLIC_API_URL=https://api.your-domain.example
# INLET_HOSTED_API_QA_REQUIRE=1
# INLET_HOSTED_API_EXPECT_D1=1

# Session auth. Use strict mode for deployed manager invite/session flows.
# INLET_SESSION_AUTH_MODE=dev-headers
# INLET_SESSION_SECRET=replace-with-long-random-secret

# Lead delivery retry.
# INLET_DELIVERY_AUTO_RETRY=1
# INLET_DELIVERY_RETRY_INTERVAL_MS=60000
# INLET_DELIVERY_RETRY_MAX_ATTEMPTS=3

# Auth email delivery for Cloudflare Pages Functions. Use api or ses for AWS SES; mock exposes token only for local QA.
# INLET_AUTH_EMAIL_MODE=api
# INLET_EMAIL_PROVIDER=ses
# INLET_AUTH_EMAIL_FROM=WAYZI <no-reply@your-domain.example>
# AWS_SES_REGION=ap-northeast-2
# AWS_SES_ACCESS_KEY_ID=your-access-key-id
# AWS_SES_SECRET_ACCESS_KEY=your-secret-access-key

# Legacy SMTP delivery for local/server integration smoke only. Do not use raw SMTP sockets in Pages Functions.
# INLET_SMTP_HOST=smtp.example.com
# INLET_SMTP_PORT=587
# INLET_SMTP_SECURE=0
# INLET_SMTP_USER=notice@example.com
# INLET_SMTP_PASS=your-password
# INLET_SMTP_FROM=notice@example.com

# Server AI generation.
# OPENAI_API_KEY=sk-...
# INLET_AI_TIMEOUT_MS=45000
# INLET_AI_FALLBACK_MODEL=gpt-4.1-mini

# Retention policy variables planned by docs/ops-pii-retention-export-policy.md.
# INLET_LEAD_RETENTION_DAYS=180
# INLET_DELIVERY_LOG_RETENTION_DAYS=30
# INLET_AI_DRAFT_RETENTION_DAYS=30
# INLET_JSONL_BACKUP_RETENTION_DAYS=30
# INLET_JSONL_QUARANTINE_RETENTION_DAYS=14
