{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "inlet",
  "compatibility_date": "2026-05-27",
  "pages_build_output_dir": "dist",
  "vars": {
    "INLET_AUTH_EMAIL_MODE": "api",
    "INLET_EMAIL_PROVIDER": "ses",
    "AWS_SES_REGION": "ap-northeast-2",
    "INLET_AUTH_EMAIL_FROM": "페이지로 <no-reply@pagero.kr>",
    "INLET_SUPPORT_EMAIL": "support@pagero.kr",
    "INLET_FILES_PROJECT_MAX_MB": "100",
    "INLET_FILES_PROJECT_MAX_COUNT": "20"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inlet-prod",
      "database_id": "b68d3820-001f-4dbe-87cd-dc9fc0be17ee"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES_BUCKET",
      "bucket_name": "inlet-files"
    }
  ]
}
